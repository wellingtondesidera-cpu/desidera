{
  "name": "ficha-cadastro",
  "compatibility_date": "2026-09-16",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      { "name": "FICHA_STORAGE", "class_name": "FichaCadastroStorage" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FichaCadastroStorage"] }
  ]
}
